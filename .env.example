# 本地 PostgreSQL 由 scripts/local_postgres.sh 启动后使用此配置。
DATABASE_URL=postgresql+psycopg://verireturn@127.0.0.1:54329/verireturn

# 本地物流/运营模拟器调用内部完成、转人工接口时使用；生产环境应由密钥服务注入。
INTERNAL_CALLBACK_TOKEN=replace-with-a-local-development-token

# Agent 接入阶段使用；不要提交真实密钥。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# M2 Agent Runtime。未配置 LLM 时使用本地 keyword fallback，便于离线演示和测试。
AGENT_SERVICE_URL=http://127.0.0.1:8000
AGENT_CONFIRMATION_TTL_SECONDS=900
AGENT_TOOL_TIMEOUT_SECONDS=8

# M4 local Chinese embedding model cache. The worker downloads BAAI/bge-small-zh-v1.5
# on first use; mount a prewarmed read-only directory in production if desired.
KNOWLEDGE_EMBEDDING_CACHE_DIR=.local/models/fastembed

# 身份适配。开发环境使用 demo Header；生产环境必须使用 JWT，且不会信任 Header 中的身份或角色。
APP_ENV=development
AUTH_MODE=demo
# APP_ENV=production
# AUTH_MODE=jwt
# AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# AUTH_JWT_ISSUER=verireturn-idp
# AUTH_JWT_AUDIENCE=verireturn-api

# M5 Provider 回调：使用独立于内部服务 token 的随机 HMAC 密钥。
# Webhook 请求签名覆盖原始 JSON body；不要记录或提交该值。
FULFILLMENT_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# 仅用于回放 M1 的旧物流模拟接口；M5 正常环境不要开启。
LEGACY_FULFILLMENT_SIMULATOR_ENABLED=false

# P1 支付回调 HMAC。轮换时将旧值暂存至 PREVIOUS，确认渠道全量切换后删除。
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-payment-webhook-secret
# PAYMENT_WEBHOOK_PREVIOUS_SECRET=

# P2 对话内容保留期由离线 privacy worker 执行；审计与支付账务不在该清理范围。
MESSAGE_RETENTION_DAYS=90
